{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",            // keep commonjs for NestJS unless fully moving to ESM
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,   // ✅ required for decorators
    "emitDecoratorMetadata": true,    // ✅ required for class-transformer
    "skipLibCheck": true
  }
}